# No credential values belong in Git or chat. Configure these in Vercel / .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional separate URL for server/CLI; otherwise uses NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
# Server-only, never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Auto-enables when the server URL/key are present. Set false to force preview-only mode.
WEDDING_DATABASE_ENABLED=
# Review drafts on local/Preview environments. Draft forms remain disabled.
WEDDING_ALLOW_DRAFTS=false
